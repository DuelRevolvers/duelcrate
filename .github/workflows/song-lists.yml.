# Rebuilds Tune Timeline's genre lists every Monday and commits them.
# Needs a repository secret named LASTFM_API_KEY.
name: Song lists

on:
  schedule:
    - cron: '17 6 * * 1'
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: song-lists
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 330
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - name: Build lists
        run: node tools/build-song-lists.js
        env:
          LASTFM_API_KEY: ${{ secrets.LASTFM_API_KEY }}
          MAX_MINUTES: '300'
      - name: Commit lists
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add lists
          if git diff --cached --quiet; then
            echo "No changes."
          else
            git commit -m "Update song lists"
            git push
          fi
